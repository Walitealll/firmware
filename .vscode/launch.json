{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flash and debug",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/firmware.elf",
      "servertype": "openocd",
      "device": "STM32F103C8",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f1x.cfg"
      ],
      "runToEntryPoint": "main",
      "preLaunchTask": "build",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 2
      }
    }
  ]
}
